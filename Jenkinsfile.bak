pipeline {
    agent any
    environment {
        DOCKER_HOST = "unix:///var/run/docker.sock"
    }
    stages {
        stage('checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/hamidsoleymani/atientInformationSystem.git'
            }
        }
        stage('build') {
            steps {
                sh 'chmod +x ./mvnw'  // Make mvnw executable
                sh './mvnw clean install -DskipTest'  // -DskipTests Ensure mvnw is executable OR use 'mvn clean install'
            }
        }
        stage('capture') {
            steps {
                archiveArtifacts '**/target/*.jar'  // Archive built JAR files from the target directory
                junit '**/target/surefire-reports/*.xml'  // Archive JUnit test results
                jacoco(execPattern: '**/target/jacoco.exec') // Configure JaCoCo for code coverage
            }
        }

    }
    post {
        always {
            cleanWs() // Clean up workspace
        }
        success {
            echo 'Build successful!'
        }
        unstable {
            echo 'Build unstable.'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
